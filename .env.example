# Vision providers — you only need one
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Convex storage integration (optional)
# If set, the API uploads the assembled tour_config to Convex storage via your
# CampusNest HTTP action and returns the resulting public URL as `tour_url`.
# See README → "Convex storage integration" for the matching CampusNest snippet.
CONVEX_STORAGE_URL=
CONVEX_STORAGE_TOKEN=
